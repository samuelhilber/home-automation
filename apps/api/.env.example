# Copy to .env (git-ignored). The token is created in the Home Assistant profile
# page under "Long-lived access tokens". Never commit the real values.
HA_URL=http://localhost:8123
HA_TOKEN=
# Optional: address of the Pi probe (tools/pi-probe), e.g. http://<pi address>:8788/status.
# Without it the System page shows no Pi values.
PI_PROBE_URL=
# Defaults: localhost only, port 8787.
HOST=127.0.0.1
PORT=8787
