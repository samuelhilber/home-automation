# Copy to .env (git-ignored). The token is created in the Home Assistant profile
# page under "Long-lived access tokens". Never commit the real values.
HA_URL=http://localhost:8123
HA_TOKEN=
# Optional: address of the Pi probe (tools/pi-probe), e.g. http://<pi address>:8788/status.
# Without it the System page shows no Pi values.
PI_PROBE_URL=
# Calendars (ADR-028). CALENDARS_FILE is a git-ignored JSON file with the read-only links:
# {"calendars":[{"id":"school","source":"Outlook Schule","name":"Stundenplan","url":"https://..."}]}
# CALENDAR_STATE_FILE keeps the on/off switches (put it in a Docker volume).
CALENDARS_FILE=
CALENDAR_STATE_FILE=
# Defaults: localhost only, port 8787.
HOST=127.0.0.1
PORT=8787
# Folder with the built apps (admin/ and tv/), set in the container (ADR-026). Unset in dev.
WEB_ROOT=
